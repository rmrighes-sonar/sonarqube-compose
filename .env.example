# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# must never be committed.
#
# This stack intentionally tracks the latest release on every image
# (SonarQube's rolling `enterprise` tag here, and `latest` for Prometheus/
# Grafana in compose.yaml) for simplicity in local demos, rather than
# pinning to immutable versions. Trade-off: `docker compose pull` can
# introduce breaking changes between runs, so only re-pull deliberately,
# and expect to occasionally re-validate the stack after doing so.
SONARQUBE_IMAGE=sonarqube:enterprise

POSTGRES_DB=sonarqube
POSTGRES_USER=sonar
POSTGRES_PASSWORD=changeme

# Passcode used to authenticate monitoring calls (e.g. Prometheus scraping
# /api/monitoring/metrics) without using an admin user's credentials. This is
# the single source of truth: Prometheus receives it via a Compose secret
# sourced from this same env var (see compose.yaml `secrets:` block), so it
# never needs to be duplicated into a tracked config file.
SONAR_SYSTEM_PASSCODE=changeme
GRAFANA_ADMIN_PASSWORD=changeme

# Used by sonarqube-exporter (a separate service/repo:
# rmrighes-sonar/sonarqube-exporter) to query /api/projects, /api/measures,
# /api/components, /api/ce for the Usage dashboard's Prometheus metrics.
# Generate in SonarQube: My Account > Security > Generate Tokens (or a
# dedicated read-only service account). Needs Browse permission on the
# projects/portfolios you want charted.
SONARQUBE_API_TOKEN=your_sonarqube_user_token

# Required only for the `share` profile.
NGROK_AUTHTOKEN=your_ngrok_authtoken
NGROK_URL=https://your-subdomain.ngrok.io

# Required only for the `mcp` profile (lets AI agents like Cursor query
# SonarQube via its hosted MCP proxy at http://localhost:9000/mcp). Must
# match the MCP Server version compatible with SONARQUBE_IMAGE's version --
# see the compatibility table:
# https://docs.sonarsource.com/sonarqube-mcp-server/setup/sonarqube-server-hosted
MCP_VERSION=1.22.0.3040
