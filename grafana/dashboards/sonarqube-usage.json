        },
        "query": {
          "type": "json",
          "format": "table",
          "source": "url",
          "url": "http://sonarqube:9000/api/projects/search?ps=500",
          "url_options": {
            "method": "GET"
          },
          "parser": "backend",
          "root_selector": "$.components",
          "columns": [
            {
              "selector": "key",
              "text": "__value",
