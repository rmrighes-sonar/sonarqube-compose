        {
          "id": 12,
          "title": "Last analysis status by project",
          "description": "sonarqube_project_last_analysis_status -- derived from the most recent Compute Engine task per project. This replaces the old raw 'recent analyses' event list: exact timestamps/durations/error messages for individual tasks aren't re-exposed as metrics (see sonarqube-prometheus-exporter's README trade-offs). For that level of detail, cross-reference the Server Health dashboard's Compute Engine panels (native SonarQube metrics, unaffected by this change) or query SonarQube's /api/ce/activity directly.",
          "type": "table",
          "gridPos": { "h": 9, "w": 24, "x": 0, "y": 56 },
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "targets": [
            {
              "refId": "A",
              "expr": "sonarqube_project_last_analysis_status{project=~\"$project\"} == 1",
              "instant": true,
              "format": "table"
            }
          ],
          "transformations": [
            {
              "id": "organize",
              "options": {
                "excludeByName": { "Time": true, "Value": true, "__name__": true, "instance": true, "job": true },
                "indexByName": { "project": 0, "status": 1 },
                "renameByName": { "project": "Project", "status": "Status" }
              }
            }
          ],
          "fieldConfig": {
            "defaults": { "custom": { "align": "auto", "filterable": true, "inspect": false, "cellOptions": { "type": "auto" } } },
            "overrides": [
              {
                "matcher": { "id": "byName", "options": "Project" },
                "properties": [
                  { "id": "links", "value": [{ "title": "Open in SonarQube", "url": "http://localhost:9000/dashboard?id=${__value.text}" }] }
