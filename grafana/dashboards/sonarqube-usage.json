                    { "value": 3, "color": "orange" },
                    { "value": 10, "color": "red" }
                  ]
                }
              },
              { "id": "custom.cellOptions", "value": { "mode": "basic", "type": "color-background" } }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "^(Reliability|Security|Maintainability)$" },
            "properties": [
              { "id": "decimals", "value": 0 },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": { "text": "A", "color": "green" },
                      "2": { "text": "B", "color": "super-light-green" },
                      "3": { "text": "C", "color": "yellow" },
                      "4": { "text": "D", "color": "orange" },
                      "5": { "text": "E", "color": "red" }
                    }
                  }
                ]
