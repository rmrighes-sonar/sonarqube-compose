{
  "title": "SonarQube Usage - Projects & Portfolios",
  "description": "Quality/usage snapshot for SonarQube projects and portfolios. Backed entirely by the Prometheus datasource: sonarqube_project_*/sonarqube_portfolio_* metrics come from the sonarqube-prometheus-exporter service (github.com/rmrighes-sonar/sonarqube-prometheus-exporter), scraped every 60s -- not from a direct SonarQube API call on every dashboard view. See that repo's README for the full metric contract.",
  "uid": "sonarqube-usage",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "tags": ["sonarqube", "usage"],
  "timezone": "browser",
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "links": [
    {
      "asDropdown": false,
      "icon": "dashboard",
      "includeVars": false,
      "keepTime": false,
      "tags": [],
      "targetBlank": false,
      "title": "Server Health",
      "type": "link",
      "url": "/d/sonarqube-health"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "project",
        "label": "Project",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(sonarqube_project_info, project)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "project_history",
        "label": "Project (history)",
        "description": "Single project for the trend row.",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(sonarqube_project_info, project)",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": { "text": "gradle-basic", "value": "gradle-basic" }
      },
      {
        "name": "portfolio",
        "label": "Portfolio",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(sonarqube_portfolio_info, portfolio)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Summary",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 20,
      "title": "Failing quality gates",
      "description": "count(sonarqube_project_quality_gate_status{status=\"ERROR\"} == 1)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "count(sonarqube_project_quality_gate_status{project=~\"$project\", status=\"ERROR\"} == 1) or vector(0)",
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 1, "color": "red" }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      }
    },
    {
      "id": 21,
      "title": "Lines of code",
      "description": "sum(sonarqube_project_lines_of_code)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 5, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(sonarqube_project_lines_of_code{project=~\"$project\"}) or vector(0)",
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "blue" }] }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      }
    },
    {
      "id": 22,
      "title": "Average coverage",
      "description": "avg(sonarqube_project_coverage_percent)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 10, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(sonarqube_project_coverage_percent{project=~\"$project\"})",
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "noValue": "–",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 50, "color": "orange" },
              { "value": 80, "color": "green" }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      }
    },
    {
      "id": 23,
      "title": "Vulnerabilities",
      "description": "sum(sonarqube_project_vulnerabilities)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 15, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(sonarqube_project_vulnerabilities{project=~\"$project\"}) or vector(0)",
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 1, "color": "orange" },
              { "value": 5, "color": "red" }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      }
    },
    {
      "id": 24,
      "title": "Bugs",
      "description": "sum(sonarqube_project_bugs)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(sonarqube_project_bugs{project=~\"$project\"}) or vector(0)",
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 1, "color": "orange" },
              { "value": 20, "color": "red" }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      }
    },
    {
      "id": 16,
      "title": "Analysis recency",
      "description": "(sonarqube_project_last_analysis_timestamp_seconds * 1000) joined with sonarqube_project_info via group_left for name/revision. Stalest first.",
      "type": "table",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "(sonarqube_project_last_analysis_timestamp_seconds{project=~\"$project\"} * 1000) * on(project) group_left(name, revision) sonarqube_project_info{project=~\"$project\"}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "instance": true, "job": true },
            "indexByName": { "project": 0, "name": 1, "revision": 2, "Value": 3 },
            "renameByName": {
              "project": "Project",
              "name": "Name",
              "revision": "Revision",
              "Value": "Last analysis"
            }
          }
        },
        {
          "id": "sortBy",
          "options": { "sort": [{ "field": "Last analysis", "desc": false }] }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "filterable": true, "inspect": false }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Project" },
            "properties": [
              {
                "id": "links",
                "value": [{ "title": "Open in SonarQube", "url": "http://localhost:9000/dashboard?id=${__value.text}" }]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Last analysis" },
            "properties": [{ "id": "unit", "value": "dateTimeFromNow" }]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [{ "displayName": "Last analysis", "desc": false }]
      }
    },
    {
      "id": 4,
      "title": "Quality gate status",
      "description": "count by (status) (sonarqube_project_quality_gate_status == 1)",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (status) (sonarqube_project_quality_gate_status{project=~\"$project\"} == 1)",
          "instant": true,
          "format": "time_series",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "OK" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "ERROR" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "WARN" },
            "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }]
          }
        ]
      },
      "options": {
        "pieType": "donut",
        "displayLabels": ["name", "percent"],
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "values": ["value"] },
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },
    {
      "id": 3,
      "type": "row",
      "title": "Issues",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "panels": []
    },
    {
      "id": 5,
      "title": "Top projects by bugs",
      "description": "topk(10, sonarqube_project_bugs) -- Prometheus's own topk() and per-series labels replace the sort/limit/rowsToFields transform chain a table-based datasource would need.",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sonarqube_project_bugs{project=~\"$project\"})",
          "instant": true,
          "format": "time_series",
          "legendFormat": "{{project}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 1, "color": "yellow" },
              { "value": 5, "color": "orange" },
              { "value": 20, "color": "red" }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true,
        "valueMode": "color"
      }
    },
    {
      "id": 6,
      "title": "Top projects by vulnerabilities",
      "description": "topk(10, sonarqube_project_vulnerabilities)",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sonarqube_project_vulnerabilities{project=~\"$project\"})",
          "instant": true,
          "format": "time_series",
          "legendFormat": "{{project}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 1, "color": "orange" },
              { "value": 5, "color": "red" }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true,
        "valueMode": "color"
      }
    },
    {
      "id": 7,
      "type": "row",
      "title": "Codebase size",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "panels": []
    },
    {
      "id": 8,
      "title": "Lines of code by project",
      "description": "sonarqube_project_lines_of_code. Cross-reference remaining license lines on Server Health.",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sonarqube_project_lines_of_code{project=~\"$project\"}",
          "instant": true,
          "format": "time_series",
          "legendFormat": "{{project}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "short",
          "color": { "mode": "continuous-blues" }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true,
        "valueMode": "color"
      }
    },
    {
      "id": 30,
      "type": "row",
      "title": "Project measures",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 },
      "panels": []
    },
    {
      "id": 2,
      "title": "Projects overview",
      "description": "One Prometheus instant-query per metric, joined by the project label (Transformations: Join by field, outer, on 'project'). Every field here is exactly what sonarqube-prometheus-exporter emits -- no pivoting/renaming of ambiguous combined field names, unlike the Infinity-datasource version this replaced.",
      "type": "table",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sonarqube_project_quality_gate_status{project=~\"$project\"} == 1", "instant": true, "format": "table" },
        { "refId": "B", "expr": "sonarqube_project_bugs{project=~\"$project\"}", "instant": true, "format": "table" },
        { "refId": "C", "expr": "sonarqube_project_new_bugs{project=~\"$project\"}", "instant": true, "format": "table" },
        { "refId": "D", "expr": "sonarqube_project_vulnerabilities{project=~\"$project\"}", "instant": true, "format": "table" },
        { "refId": "E", "expr": "sonarqube_project_new_vulnerabilities{project=~\"$project\"}", "instant": true, "format": "table" },
        { "refId": "F", "expr": "sonarqube_project_security_hotspots{project=~\"$project\"}", "instant": true, "format": "table" },
        { "refId": "G", "expr": "sonarqube_project_code_smells{project=~\"$project\"}", "instant": true, "format": "table" },
        { "refId": "H", "expr": "sonarqube_project_coverage_percent{project=~\"$project\"}", "instant": true, "format": "table" },
        { "refId": "I", "expr": "sonarqube_project_new_coverage_percent{project=~\"$project\"}", "instant": true, "format": "table" },
        { "refId": "J", "expr": "sonarqube_project_duplicated_lines_percent{project=~\"$project\"}", "instant": true, "format": "table" },
        { "refId": "K", "expr": "sonarqube_project_lines_of_code{project=~\"$project\"}", "instant": true, "format": "table" },
        { "refId": "L", "expr": "sonarqube_project_reliability_rating{project=~\"$project\"}", "instant": true, "format": "table" },
        { "refId": "M", "expr": "sonarqube_project_security_rating{project=~\"$project\"}", "instant": true, "format": "table" },
        { "refId": "N", "expr": "sonarqube_project_maintainability_rating{project=~\"$project\"}", "instant": true, "format": "table" }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": { "byField": "project", "mode": "outer" }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true, "Time 1": true, "Time 2": true, "Time 3": true, "Time 4": true,
              "Time 5": true, "Time 6": true, "Time 7": true, "Time 8": true, "Time 9": true,
              "Time 10": true, "Time 11": true, "Time 12": true, "Time 13": true, "Time 14": true,
              "__name__": true, "__name__ 1": true, "__name__ 2": true, "__name__ 3": true,
              "__name__ 4": true, "__name__ 5": true, "__name__ 6": true, "__name__ 7": true,
              "__name__ 8": true, "__name__ 9": true, "__name__ 10": true, "__name__ 11": true,
              "__name__ 12": true, "__name__ 13": true, "__name__ 14": true,
              "instance": true, "instance 1": true, "instance 2": true, "instance 3": true,
              "instance 4": true, "instance 5": true, "instance 6": true, "instance 7": true,
              "instance 8": true, "instance 9": true, "instance 10": true, "instance 11": true,
              "instance 12": true, "instance 13": true, "instance 14": true,
              "job": true, "job 1": true, "job 2": true, "job 3": true, "job 4": true,
              "job 5": true, "job 6": true, "job 7": true, "job 8": true, "job 9": true,
              "job 10": true, "job 11": true, "job 12": true, "job 13": true, "job 14": true,
              "Value #A": true
            },
            "indexByName": {
              "project": 0,
              "status": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5,
              "Value #F": 6,
              "Value #G": 7,
              "Value #H": 8,
              "Value #I": 9,
              "Value #J": 10,
              "Value #K": 11,
              "Value #L": 12,
              "Value #M": 13,
              "Value #N": 14
            },
            "renameByName": {
              "project": "Project",
              "status": "Quality gate",
              "Value #B": "Bugs",
              "Value #C": "New bugs",
              "Value #D": "Vulnerabilities",
              "Value #E": "New vulns",
              "Value #F": "Hotspots",
              "Value #G": "Code smells",
              "Value #H": "Coverage",
              "Value #I": "New coverage",
              "Value #J": "Duplication",
              "Value #K": "LoC",
              "Value #L": "Reliability",
              "Value #M": "Security",
              "Value #N": "Maintainability"
            }
          }
        },
        {
          "id": "sortBy",
          "options": { "sort": [{ "field": "Quality gate", "desc": false }] }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "filterable": true, "inspect": false, "cellOptions": { "type": "auto" } }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Project" },
            "properties": [
              { "id": "links", "value": [{ "title": "Open in SonarQube", "url": "http://localhost:9000/dashboard?id=${__value.text}" }] }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Quality gate" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "OK": { "text": "OK", "color": "green" },
                      "ERROR": { "text": "ERROR", "color": "red" },
                      "WARN": { "text": "WARN", "color": "yellow" },
                      "NONE": { "text": "NONE", "color": "text" }
                    }
                  }
                ]
              },
              { "id": "custom.cellOptions", "value": { "mode": "basic", "type": "color-background" } }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "^(New bugs|New vulns)$" },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "value": null, "color": "green" },
                    { "value": 1, "color": "orange" },
                    { "value": 5, "color": "red" }
                  ]
                }
              },
              { "id": "custom.cellOptions", "value": { "mode": "basic", "type": "color-background" } }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "^(Coverage|New coverage)$" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "decimals", "value": 1 },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "value": null, "color": "red" },
                    { "value": 50, "color": "orange" },
                    { "value": 80, "color": "green" }
                  ]
                }
              },
              { "id": "custom.cellOptions", "value": { "mode": "basic", "type": "color-background" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Duplication" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "decimals", "value": 1 },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
