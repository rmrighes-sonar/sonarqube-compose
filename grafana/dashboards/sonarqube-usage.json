      "panels": []
    },
    {
      "id": 14,
      "title": "Coverage and duplication",
      "description": "Real Prometheus history (retained since sonarqube-prometheus-exporter started being scraped) for Project (history) -- no dependency on SonarQube's search_history API anymore. Overrides the dashboard time range to the last 6h: over the dashboard's 90d default the calculated step is coarse (hours) and its timezone-aligned grid can miss the still-short real history on a freshly started stack, showing 'No data' even though the metric is live. A short, fixed window keeps the step fine-grained enough to always catch it.",
      "type": "timeseries",
      "timeFrom": "6h",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 45 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sonarqube_project_coverage_percent{project=\"$project_history\"}",
          "legendFormat": "Coverage",
          "format": "time_series"
        },
        {
          "refId": "B",
          "expr": "sonarqube_project_duplicated_lines_percent{project=\"$project_history\"}",
          "legendFormat": "Duplication",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "drawStyle": "line", "fillOpacity": 12, "lineWidth": 2, "pointSize": 6, "showPoints": "always", "spanNulls": true }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Coverage" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Duplication" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] }
        ]
      },
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },
    {
      "id": 15,
      "title": "Lines of code",
