    {
      "id": 16,
      "title": "Analysis recency",
      "description": "Last analysis time for selected projects (stale first). Uses /api/components/search and the Project variable.",
      "type": "table",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 5 },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "sonarqube-api"
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "format": "table",
          "source": "url",
          "url": "http://sonarqube:9000/api/components/search?qualifiers=TRK&ps=500",
          "url_options": { "method": "GET" },
          "parser": "backend",
          "root_selector": "$.components",
          "columns": [
            { "selector": "key", "text": "Project", "type": "string" },
            { "selector": "name", "text": "Name", "type": "string" },
            { "selector": "lastAnalysisDate", "text": "Last analysis", "type": "timestamp" }
          ]
        }
      ],
      "transformations": [
        {
          "id": "filterByValue",
          "options": {
            "filters": [
              {
                "fieldName": "Project",
                "config": {
                  "id": "regex",
                  "options": { "value": "${project:regex}" }
                }
              }
            ],
            "match": "any",
            "type": "include"
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [{ "field": "Last analysis", "desc": false }]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "filterable": true, "inspect": false }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Project" },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open in SonarQube",
                    "url": "http://localhost:9000/dashboard?id=${__value.text}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Last analysis" },
            "properties": [
              { "id": "unit", "value": "dateTimeFromNow" }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [{ "displayName": "Last analysis", "desc": false }]
      }
    },
