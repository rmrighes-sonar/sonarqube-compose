    {
      "id": 20,
      "title": "Failing quality gates",
      "description": "Count of selected projects whose quality gate is ERROR. Snapshot from the project measures table.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 0, "y": 1 },
      "datasource": { "type": "datasource", "uid": "-- Dashboard --" },
      "targets": [
        { "refId": "A", "panelId": 2, "withTransforms": true }
      ],
      "transformations": [
        {
          "id": "filterByValue",
          "options": {
            "filters": [
              {
                "fieldName": "QualityGate",
                "config": {
                  "id": "equal",
                  "options": { "value": "ERROR" }
                }
              }
            ],
            "match": "any",
            "type": "include"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": { "names": ["Project"] }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 1, "color": "red" }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["count"],
          "fields": "",
          "values": false
