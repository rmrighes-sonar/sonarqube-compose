  "schemaVersion": 39,
  "version": 7,
  "editable": true,
  "graphTooltip": 1,
  "preload": false,
  "refresh": "5m",
  "tags": ["sonarqube", "usage"],
  "timezone": "browser",
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "links": [
    {
      "asDropdown": false,
      "icon": "dashboard",
      "includeVars": false,
      "keepTime": false,
      "tags": [],
