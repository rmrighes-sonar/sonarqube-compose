    {
      "id": 2,
      "title": "Projects overview",
      "description": "One /api/measures/search call for overall metrics plus one for new-code metrics (period values), pivoted on project key. /api/measures/search is an internal SonarQube endpoint; if it breaks on upgrade, fall back to /api/measures/component (one call per project). The Project variable's All option is disabled so projectKeys always interpolates to concrete keys.",
      "type": "table",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 32 },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "sonarqube-api"
      },
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "metric",
            "rowField": "component",
            "valueField": "value"
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              { "destinationType": "number", "targetField": "bugs" },
              { "destinationType": "number", "targetField": "new_bugs" },
              { "destinationType": "number", "targetField": "vulnerabilities" },
              { "destinationType": "number", "targetField": "new_vulnerabilities" },
              { "destinationType": "number", "targetField": "security_hotspots" },
              { "destinationType": "number", "targetField": "code_smells" },
              { "destinationType": "number", "targetField": "coverage" },
              { "destinationType": "number", "targetField": "new_coverage" },
              { "destinationType": "number", "targetField": "duplicated_lines_density" },
              { "destinationType": "number", "targetField": "ncloc" },
              { "destinationType": "number", "targetField": "security_rating" },
              { "destinationType": "number", "targetField": "reliability_rating" },
              { "destinationType": "number", "targetField": "sqale_rating" }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "component\\metric": 0,
              "alert_status": 1,
              "bugs": 2,
              "new_bugs": 3,
              "vulnerabilities": 4,
