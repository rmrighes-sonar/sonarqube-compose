    {
      "id": 2,
      "title": "Projects overview",
      "description": "Built by joining 9 separate SonarQube measures/search calls (one per metric) on the component key. /api/measures/search is an internal/undocumented SonarQube endpoint; if it stops working on a future SonarQube upgrade, fall back to /api/measures/component (one call per project). The Project variable's 'All' option is intentionally disabled -- Grafana's All-value expansion did not reliably resolve to the real project list for this Infinity datasource/variable combination. Select one or more concrete projects from the dropdown instead.",
      "type": "table",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "sonarqube-api"
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "component",
            "mode": "outer"
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "format": "table",
          "source": "url",
          "url": "http://sonarqube:9000/api/measures/search?projectKeys=${project:csv}&metricKeys=alert_status",
          "url_options": {
            "method": "GET"
          },
          "parser": "backend",
          "root_selector": "$.measures",
          "columns": [
            {
              "selector": "component",
              "text": "component",
              "type": "string"
            },
            {
              "selector": "value",
              "text": "QualityGate",
              "type": "string"
            }
