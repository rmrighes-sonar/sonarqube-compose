            "gradle-kotlin-project",
            "gradle-multimodule",
            "gradle-multimodule-coverage",
            "maven-basic",
            "maven-multilingual",
            "maven-multimodule"
          ],
          "value": [
            "gradle-basic",
            "gradle-kotlin-dsl",
            "gradle-kotlin-project",
            "gradle-multimodule",
            "gradle-multimodule-coverage",
