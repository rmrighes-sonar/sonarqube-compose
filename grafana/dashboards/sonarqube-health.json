{
  "title": "SonarQube Server Health",
  "uid": "sonarqube-health",
  "schemaVersion": 39,
  "version": 6,
  "tags": ["sonarqube", "health"],
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Availability & Health",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 2,
      "title": "SonarQube reachability",
      "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "up{job=\"sonarqube\"}", "refId": "A" }],
      "options": { "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Down", "color": "red" }, "1": { "text": "Up", "color": "green" } } }
          ]
        }
      }
    },
    {
      "id": 3,
      "title": "Web process",
      "type": "stat",
      "gridPos": { "h": 5, "w": 5, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sonarqube_health_web_status", "refId": "A" }],
      "options": { "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Down", "color": "red" }, "1": { "text": "Up", "color": "green" } } }
          ]
        }
      }
    },
    {
      "id": 4,
      "title": "Compute Engine",
      "type": "stat",
      "gridPos": { "h": 5, "w": 5, "x": 9, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sonarqube_health_compute_engine_status", "refId": "A" }],
      "options": { "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Down", "color": "red" }, "1": { "text": "Up", "color": "green" } } }
          ]
        }
      }
    },
    {
      "id": 5,
      "title": "Elasticsearch",
      "type": "stat",
      "gridPos": { "h": 5, "w": 5, "x": 14, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sonarqube_health_elasticsearch_status", "refId": "A" }],
      "options": { "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Down", "color": "red" }, "1": { "text": "Up", "color": "green" } } }
          ]
        }
      }
    },
    {
      "id": 6,
      "title": "Uptime",
      "type": "stat",
      "gridPos": { "h": 5, "w": 5, "x": 19, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sonarqube_web_uptime_minutes", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "m" } }
    },

    {
      "id": 7,
      "type": "row",
      "title": "License",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "panels": []
    },
    {
      "id": 8,
      "title": "License days before expiration",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sonarqube_license_days_before_expiration_total", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "min": 0,
          "max": 365,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 7, "color": "orange" },
              { "value": 30, "color": "green" }
            ]
          }
        }
      }
    },
    {
      "id": 9,
      "title": "Lines analyzed vs remaining",
      "type": "bargauge",
      "gridPos": { "h": 6, "w": 16, "x": 8, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sonarqube_license_number_of_lines_analyzed_total", "refId": "A", "legendFormat": "Analyzed" },
        { "expr": "sonarqube_license_number_of_lines_remaining_total", "refId": "B", "legendFormat": "Remaining" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },

    {
      "id": 10,
      "type": "row",
      "title": "Elasticsearch",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "panels": []
    },
    {
      "id": 11,
      "title": "Elasticsearch disk usage",
      "type": "gauge",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sonarqube_elasticsearch_disk_usage_percent", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 70, "color": "orange" },
              { "value": 85, "color": "red" }
            ]
          }
        }
      }
    },
    {
      "id": 13,
      "title": "Read-only indices",
      "type": "stat",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sonarqube_elasticsearch_read_only_indices_total", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 1, "color": "red" }
            ]
          }
        }
      }
    },

    {
      "id": 14,
      "type": "row",
      "title": "Compute Engine execution",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 21 },
      "panels": []
    },
    {
      "id": 15,
      "title": "Compute Engine pending tasks",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sonarqube_compute_engine_pending_tasks_total", "refId": "A", "legendFormat": "Pending tasks" }]
    },
    {
      "id": 16,
      "title": "Avg Compute Engine task duration by type",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(sonarqube_compute_engine_tasks_running_duration_seconds_sum[5m]) / rate(sonarqube_compute_engine_tasks_running_duration_seconds_count[5m])",
          "refId": "A",
          "legendFormat": "{{task_type}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 17,
      "title": "Compute Engine task duration by project",
      "type": "table",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "topk(10, sum by (project_key, task_type) (rate(sonarqube_compute_engine_tasks_running_duration_seconds_sum[5m])))",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },

    {
      "id": 18,
      "type": "row",
      "title": "Web & API performance",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 30 },
      "panels": []
    },
    {
      "id": 19,
      "title": "Web API v1 request rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 31 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(sonarqube_web_api_v1_request_duration_seconds_count[5m]))", "refId": "A", "legendFormat": "requests/sec" }],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 20,
      "title": "Web API v1 p95 latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 31 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(sonarqube_web_api_v1_request_duration_seconds_bucket[5m])) by (le))",
          "refId": "A",
          "legendFormat": "p95 latency"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 21,
      "title": "Web API v2 request rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 31 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(sonarqube_web_api_v2_request_duration_seconds_count[5m]))", "refId": "A", "legendFormat": "requests/sec" }],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 22,
      "title": "Web API v2 p95 latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 31 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(sonarqube_web_api_v2_request_duration_seconds_bucket[5m])) by (le))",
          "refId": "A",
          "legendFormat": "p95 latency"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },

    {
      "id": 23,
      "type": "row",
      "title": "Database",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 39 },
      "panels": []
    },
    {
      "id": 24,
      "title": "DB query rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(sonarqube_db_query_duration_seconds_count[5m]))", "refId": "A", "legendFormat": "queries/sec" }],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 25,
      "title": "DB query p95 latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(sonarqube_db_query_duration_seconds_bucket[5m])) by (le))",
          "refId": "A",
          "legendFormat": "p95 latency"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },

    {
      "id": 26,
      "type": "row",
      "title": "Integrations & Clients",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 48 },
      "panels": []
    },
    {
      "id": 27,
      "title": "GitHub integration",
      "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 49 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sonarqube_health_integration_github_status", "refId": "A" }],
      "options": { "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Not configured / red", "color": "red" }, "1": { "text": "Green", "color": "green" } } }
          ]
        }
      }
    },
    {
      "id": 28,
      "title": "GitLab integration",
      "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 49 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sonarqube_health_integration_gitlab_status", "refId": "A" }],
      "options": { "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Not configured / red", "color": "red" }, "1": { "text": "Green", "color": "green" } } }
          ]
        }
      }
    },
    {
      "id": 29,
      "title": "Bitbucket integration",
      "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 49 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sonarqube_health_integration_bitbucket_status", "refId": "A" }],
      "options": { "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Not configured / red", "color": "red" }, "1": { "text": "Green", "color": "green" } } }
          ]
        }
      }
    },
    {
      "id": 30,
      "title": "Azure DevOps integration",
      "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 49 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sonarqube_health_integration_azuredevops_status", "refId": "A" }],
      "options": { "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Not configured / red", "color": "red" }, "1": { "text": "Green", "color": "green" } } }
          ]
        }
      }
    },
    {
      "id": 31,
      "title": "Connected SonarLint clients",
      "type": "stat",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 49 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sonarqube_number_of_connected_sonarlint_clients", "refId": "A" }]
    },

    {
      "id": 32,
      "type": "row",
      "title": "Prometheus",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 54 },
      "panels": []
    },
    {
      "id": 33,
      "title": "Prometheus scrape duration",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 55 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "scrape_duration_seconds{job=\"sonarqube\"}", "refId": "A", "legendFormat": "scrape duration" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 34,
      "title": "Prometheus storage usage",
      "description": "Prometheus's own TSDB storage: current size on disk (persisted blocks + WAL) vs. the --storage.tsdb.retention.size cap set in compose.yaml. Requires the 'prometheus' self-scrape job in prometheus.yml.",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 55 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "prometheus_tsdb_storage_blocks_bytes{job=\"prometheus\"} + prometheus_tsdb_wal_storage_size_bytes{job=\"prometheus\"}",
          "refId": "A",
          "legendFormat": "Current size"
        },
        {
          "expr": "prometheus_tsdb_retention_limit_bytes{job=\"prometheus\"}",
          "refId": "B",
          "legendFormat": "Total (retention cap)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Current size" },
            "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Total (retention cap)" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          }
        ]
      }
    },

    {
      "id": 35,
      "type": "row",
      "title": "External Services",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 61 },
      "panels": []
    },
    {
      "id": 36,
      "title": "MCP Server reachability",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 62 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "probe_success{job=\"blackbox-mcp\"}", "refId": "A" }],
      "options": { "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Down", "color": "red" }, "1": { "text": "Up", "color": "green" } } }
          ]
        }
      }
    },
    {
      "id": 37,
      "title": "ngrok tunnel reachability",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 62 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "probe_success{job=\"blackbox-ngrok\"}", "refId": "A" }],
      "options": { "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Down", "color": "red" }, "1": { "text": "Up", "color": "green" } } }
          ]
        }
      }
    }
  ]
}
